# Copy this file to .env and configure one AI backend before starting Rufina.

# AI backend: openai_api, anthropic_api, openclaw_codex or openclaw_claude
AI_BACKEND=openai_api

# Required when AI_BACKEND=openai_api
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-6.1-sol
OPENAI_API_REASONING_EFFORT=medium
OPENAI_API_TIMEOUT_SECONDS=120
OPENAI_API_MAX_ATTEMPTS=2
OPENAI_API_RETRY_BACKOFF_SECONDS=0.8

# Required when AI_BACKEND=anthropic_api
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_MODEL=claude-sonnet-5-5
ANTHROPIC_API_EFFORT=medium

# Optional model for resume wording and cover letters (empty: the main model).
# Example: anthropic/claude-opus-5-5 or openai/gpt-6.1-sol
DOCUMENT_GENERATION_MODEL=

# Used when AI_BACKEND=openclaw_codex or openclaw_claude.
# For openclaw_claude use anthropic/claude-sonnet-5-5.
OPENCLAW_ASSISTANT_AGENT_ID=rufina-assistant
OPENCLAW_ASSISTANT_MODEL=openai/gpt-6.1-sol
OPENCLAW_ASSISTANT_THINKING=off
OPENCLAW_ASSISTANT_TIMEOUT_SECONDS=120
OPENCLAW_ASSISTANT_MAX_ATTEMPTS=2
OPENCLAW_ASSISTANT_RETRY_BACKOFF_SECONDS=0.8

# Optional path to a system Chromium/Chrome for PDF rendering. Empty uses the
# browser installed by `python -m playwright install chromium`.
RESUME_PDF_CHROMIUM_EXECUTABLE=

# Recoverable application-document worker (seconds between queue polls)
GENERATION_WORKER_POLL_INTERVAL_SECONDS=1.0

# Automatically run full AI Match for newly added vacancies
AUTO_AI_MATCH_ENABLED=false

# Optional: enables LinkedIn and Indeed vacancy search
BRIGHTDATA_API_KEY=
BRIGHTDATA_SNAPSHOT_POLL_TIMEOUT_SECONDS=600

# Run vacancy sources concurrently and retry failed parsers at the queue tail.
VACANCY_PARSER_WORKERS=6
VACANCY_PARSER_MAX_ATTEMPTS=3

# jobs.ch handles retries per HTTP request within one search budget.
JOBS_CH_TIMEOUT_SECONDS=30
JOBS_CH_MAX_PAGES=50
JOBS_CH_DETAIL_WORKERS=6
JOBS_CH_DEADLINE_SECONDS=150
JOBS_CH_MAX_RETRIES=2

# Vacancy pre-screening. A model from another provider than AI_BACKEND falls
# back to that provider's default (for Claude: anthropic/claude-haiku-5-5).
JOB_SCREENING_MODEL=openai/gpt-6-luna
JOB_SCREENING_REASONING=none
JOB_SCREENING_BATCH_SIZE=10
JOB_SCREENING_TIMEOUT_SECONDS=60
JOB_SCREENING_MAX_ATTEMPTS=2
JOB_SCREENING_MAX_DESCRIPTION_CHARS=12000

# Local ports
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# This value is embedded into the browser bundle during next build.
# Keep it in sync with API_PORT when changing the API port.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional UI demo data
DEMO_MODE=0

# Release image names and tag
TASKO_API_IMAGE=tasko-api
TASKO_WEB_IMAGE=tasko-web
TASKO_VERSION=latest
